[Unit]
Description=Hearth native now-playing display
After=network-online.target systemd-user-sessions.service hearth-node.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=hearth video render audio input dialout i2c
PAMName=login
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=/opt/hearth-audio
Environment=HEARTH_NODE_CONFIG=/etc/hearth-audio/node.json
Environment=HEARTH_PROJECT_DIR=/opt/hearth-audio
Environment=HOME=/home/pi
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
Environment=HEARTH_DISPLAY_BACKEND=fbdev
Environment=SDL_VIDEODRIVER=dummy
Environment=SDL_AUDIODRIVER=dummy
Environment=SDL_RENDER_DRIVER=software
Environment=XDG_RUNTIME_DIR=/run/hearth-node-display
RuntimeDirectory=hearth-node-display
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/local/sbin/hearth-node-display-prepare
ExecStart=/usr/local/bin/hearth-node-display
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
