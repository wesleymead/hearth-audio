#!/usr/bin/python3
"""Apply one of Hearth's discrete ALSA soft-volume output gains."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


ALSA_CONFIG = Path("/etc/alsa/conf.d/99-hearth-output-boost.conf")
SNAPCLIENT_CONFIG = Path("/etc/default/snapclient")
CONTROL = "Hearth Output Boost"
GAINS = {-6, -3, 0, 3, 6, 9, 12}


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: hearth-snapclient-gain -6|-3|0|3|6|9|12", file=sys.stderr)
        return 2
    try:
        gain = int(sys.argv[1])
    except ValueError:
        gain = 999
    if gain not in GAINS:
        print("gain must be one of -6, -3, 0, 3, 6, 9, or 12 dB", file=sys.stderr)
        return 2
    try:
        snapclient = SNAPCLIENT_CONFIG.read_text(encoding="utf-8")
    except OSError:
        snapclient = ""
    if re.search(r"--soundcard(?:=|\s+)null(?:\s|\"|$)", snapclient):
        print(f"{gain:+d} dB saved; no physical output is active")
        return 0
    try:
        content = ALSA_CONFIG.read_text(encoding="utf-8")
    except OSError as error:
        print(f"Hearth output gain is not configured: {error}", file=sys.stderr)
        return 1
    match = re.search(r'^\s*card\s+"([A-Za-z0-9_]+)"\s*$', content, re.M)
    if not match:
        print("Could not identify the active Hearth ALSA card", file=sys.stderr)
        return 1
    result = subprocess.run(
        ["amixer", "-q", "-c", match.group(1), "--", "sset", CONTROL, f"{gain}dB"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode:
        print(result.stderr.strip() or result.stdout.strip() or "Could not set output gain", file=sys.stderr)
        return 1
    print(f"{gain:+d} dB")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
